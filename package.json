{
  "name": "pikabu-expand-comments",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) require('node:child_process').execFileSync('lefthook', ['install'], { stdio: 'inherit' })\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --project tsconfig.node.json && tsc --project tsconfig.browser.json && tsc --project tsconfig.vitest.json && tsc --project tsconfig.playwright.json",
    "build": "node lib/build.mts",
    "build:userscript": "node lib/build.mts --target=userscript",
    "build:chrome": "node lib/build.mts --target=chrome",
    "build:firefox": "node lib/build.mts --target=firefox",
    "build:source": "node lib/build.mts --target=source",
    "lint:firefox": "pnpm run build:firefox && web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "store:screenshots": "pnpm run build && node scripts/capture-store-screenshots.mts",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:live": "pnpm run build && playwright test --config playwright.live.config.mts",
    "ui:audit": "pnpm run build && playwright test --config playwright.visual.config.mts",
    "ui:capture": "pnpm run build && node tests/visual/capture.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "web-ext": "^10.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
