{
  "name": "pikabu-expand-comments",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --project tsconfig.node.json && tsc --project tsconfig.browser.json && tsc --project tsconfig.vitest.json && tsc --project tsconfig.playwright.json",
    "build": "node lib/build.mts",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:live": "pnpm run build && playwright test --config playwright.live.config.mts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
